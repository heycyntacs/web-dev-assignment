generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  password String

  notes    Note[]
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime?

  user      User     @relation(fields: [userId], references: [id])
}
