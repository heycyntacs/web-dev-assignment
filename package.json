{
  "name": "web-dev-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack web development assignment",
  "scripts": {
    "dev": "npm run dev:frontend & npm run dev:backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix backend run start",
    "deploy": "bash deploy.sh",
    "migrate": "npm --prefix backend run migrate",
    "migrate:deploy": "npm --prefix backend run migrate:deploy",
    "generate": "npm --prefix backend run generate",
    "seed": "npm --prefix backend run seed",
    "lint": "npm --prefix frontend run lint",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
